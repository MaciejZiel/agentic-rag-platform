# ──────────────────────────────────────────────────────────────
# Cortex — Environment Configuration
# Copy to .env and fill in production values
# ──────────────────────────────────────────────────────────────

# Application
APP_NAME=cortex
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=DEBUG              # DEBUG | INFO | WARNING | ERROR

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_platform

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ── Qdrant (vector store) ──────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# ── LLM (OpenRouter) ───────────────────────────────────────
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

# ── Upload ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── JWT / Authentication ────────────────────────────────────
# IMPORTANT: Change jwt_secret_key in production!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Cortex <onboarding@resend.dev>

# ── CORS ────────────────────────────────────────────────────
# Comma-separated origins. In development, all origins are allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Celery (background tasks) ──────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
